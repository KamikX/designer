{
  "name": "designer",
  "version": "1.0.0",
  "description": "Antdv Next Designer — 用自然语言对话生成多文件设计稿（HTML / Vue 3 / React），实时预览、版本管理、可导出的 AI 设计工作台",
  "main": "./out/main/index.js",
  "author": "Antdv Next",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/antdv-next/designer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antdv-next/designer.git"
  },
  "bugs": {
    "url": "https://github.com/antdv-next/designer/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-preview-vendor.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@comark/vue": "^0.5.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@shikijs/engine-javascript": "^4.3.1",
    "@shikijs/monaco": "^4.3.1",
    "@vue/compiler-sfc": "^3.5.40",
    "@vueuse/core": "^14.3.0",
    "@vueuse/electron": "^14.3.0",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.37",
    "better-sqlite3": "^13.0.1",
    "comark": "^0.5.1",
    "dayjs": "^1.11.21",
    "defuddle": "^0.19.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "magic-string": "^1.1.0",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.56.0",
    "oxc-transform": "^0.141.0",
    "pinia": "^4.0.2",
    "shiki": "^4.3.1",
    "ulid": "^3.0.2",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.1.0",
    "@antdv-next/icons": "^1.1.1",
    "@antdv-next/tailwind": "^1.1.1",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "antdv-next": "^1.4.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "npm:@antdv-next/electron-vite@^0.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-dayjs": "^1.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3"
    ]
  }
}
